{
  "name": "ideavim-vscode",
  "displayName": "IdeaVim",
  "description": "Vim emulation for VS Code, powered by the IdeaVim engine.",
  "version": "0.0.1",
  "publisher": "IdeaVim",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Keymaps",
    "Other"
  ],
  "main": "./build/compileSync/js/main/productionExecutable/kotlin/IdeaVIM-vscode-extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [],
    "keybindings": [
      {
        "key": "escape",
        "command": "ideavim.key",
        "args": "<Esc>",
        "when": "editorTextFocus"
      },
      {
        "key": "backspace",
        "command": "ideavim.key",
        "args": "<BS>",
        "when": "editorTextFocus"
      },
      {
        "key": "delete",
        "command": "ideavim.key",
        "args": "<Del>",
        "when": "editorTextFocus"
      },
      {
        "key": "enter",
        "command": "ideavim.key",
        "args": "<CR>",
        "when": "editorTextFocus && !suggestWidgetVisible"
      },
      {
        "key": "tab",
        "command": "ideavim.key",
        "args": "<Tab>",
        "when": "editorTextFocus && !suggestWidgetVisible"
      },
      {
        "key": "up",
        "command": "ideavim.key",
        "args": "<Up>",
        "when": "editorTextFocus && !suggestWidgetVisible"
      },
      {
        "key": "down",
        "command": "ideavim.key",
        "args": "<Down>",
        "when": "editorTextFocus && !suggestWidgetVisible"
      },
      {
        "key": "left",
        "command": "ideavim.key",
        "args": "<Left>",
        "when": "editorTextFocus"
      },
      {
        "key": "right",
        "command": "ideavim.key",
        "args": "<Right>",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+r",
        "command": "ideavim.key",
        "args": "<C-R>",
        "when": "editorTextFocus"
      }
    ]
  }
}
